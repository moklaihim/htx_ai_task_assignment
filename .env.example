# Committed template (REQ-7.5). Copy to .env and paste the real LLM API key:
#   cp .env.example .env

# --- Database -------------------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=taskdb
# Host `db` is the compose service name, not localhost.
DATABASE_URL=postgresql://app:app@db:5432/taskdb
# Optional (design §7.3) — how long the backend waits for a pooled Postgres
# connection before /health/db reports 503 instead of hanging. Defaults to
# 3000 if unset.
DB_CONNECTION_TIMEOUT_MS=3000

# --- Frontend -------------------------------------------------------------
# Host port the SPA is published on (http://localhost:3000).
FRONTEND_PORT=3000

# --- LLM (design §5.1) ----------------------------------------------------
# Non-sensitive defaults are committed so no reviewer action is needed (REQ-6.7).
LLM_BASE_URL=https://generativelanguage.googleapis.com
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT_MS=10000
# live | stub | fail (design §5.4)
LLM_MODE=live
# The only value that must be supplied by hand. Never commit a real key.
LLM_API_KEY=your-gemini-api-key-here
